# Required for swaps (free key: https://developers.uniswap.org)
UNISWAP_API_KEY=

# Recommended: crew notes in each agent's voice + shared cache
DEEPSEEK_API_KEY=
MONGODB_URI=
MONGODB_DB=quiver

# Recommended: a private RPC (QuickNode / Alchemy). Public one rate-limits.
RH_RPC_URL=

# Set at launch: turns on the CA box and points Buy at Pons
QUIVER_CA=
